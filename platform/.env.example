# PRODUÇÃO: Postgres gerido (Neon, Supabase, RDS, etc.)
# DATABASE_URL="postgresql://user:password@host:5432/ds_os?sslmode=require"

# DESENVOLVIMENTO LOCAL sem Docker/conta externa:
# 1. Correr `npm run db:local` num terminal (deixa-o a correr)
# 2. Copiar o DATABASE_URL que esse comando imprime para aqui
DATABASE_URL="postgresql://dsuser:dslocalpass@localhost:5433/ds_os"

# Chave de assinatura de sessão — gerar com: openssl rand -base64 32
NEXTAUTH_SECRET="troque-por-um-valor-aleatorio-antes-de-produzir"
NEXTAUTH_URL="http://localhost:3001"

# Armazenamento de ficheiros (fotografias, documentos, contratos).
# Por omissão: ./storage/uploads (disco local). Em produção sem disco
# persistente (ex.: Vercel), apontar para um volume montado ou migrar
# src/lib/storage.ts para object storage (S3/R2/Supabase Storage) — ver
# docs/producao.md.
# STORAGE_DIR="/var/data/ds-os/uploads"
