// DS OS — schema de base de dados.
// Fonte de verdade para os módulos: Auth/Permissões, CRM, Obras, Clientes,
// Financeiro, Agenda, RH e Marketing.
//
// Alinhado deliberadamente com os deliverables já existentes do CTO:
// - docs/crm-especificacao.md (objetos, pipelines, tags, indicadores)
// - crm/schema/contact-properties.json, deal-pipeline.json, deal-properties.json
//
// PostgreSQL — base de dados de produção. Os campos "categóricos" (estado,
// tipo, origem, etc.) mantêm-se como String, com os valores permitidos e
// validação centralizados em src/lib/enums.ts (TypeScript union types +
// Zod). Isto foi uma decisão deliberada mesmo com Postgres a suportar
// enums nativos: mudar um valor de enum nativo exige migração de schema;
// mudar um valor aqui é só código de aplicação — mais ágil numa fase em
// que os pipelines/estados ainda podem mudar por decisão de negócio.
//
// Desenvolvimento local sem Docker/conta externa: ver scripts/pg-dev.mjs
// (Postgres local via `embedded-postgres`, mesma engine da produção).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────
// AUTENTICAÇÃO E PERMISSÕES
// ─────────────────────────────────────────────────────────────────────────

// Role: "ADMIN" | "DIRECAO" | "COMERCIAL" | "GESTOR_PROJETO" | "FINANCEIRO" | "RH" | "MARKETING"
model User {
  id                String    @id @default(cuid())
  name              String
  email             String    @unique
  passwordHash      String
  // Marcado sempre que a password muda (reposição por um admin ou
  // alteração pelo próprio em "O Meu Perfil") — usado por auth.ts para
  // revogar imediatamente sessões já emitidas antes da mudança, em vez de
  // esperar a expiração natural do token (até 8h). Sem isto, repor a
  // password de uma conta comprometida bloqueava novos logins mas não
  // terminava uma sessão já aberta por um atacante.
  passwordChangedAt DateTime?
  role              String    @default("COMERCIAL")
  active            Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  employee      Employee?
  dealsOwned    Deal[]        @relation("DealOwner")
  projectsOwned Project[]     @relation("ProjectOwner")
  tasksAssigned Task[]        @relation("TaskAssignee")
  tasksCreated  Task[]        @relation("TaskCreator")
  taskComments  TaskComment[]
  attachments   Attachment[]
  activityLogs  ActivityLog[]

  // Módulo "Site — Portefólio" (ver secção WEBSITE / CMS INTERNO, fundo do
  // ficheiro) — quem criou/editou cada obra ou testemunho publicável no site.
  websiteCaseStudiesCreated  WebsiteCaseStudy[]   @relation("WebsiteCaseStudyCreatedBy")
  websiteTestimonialsCreated WebsiteTestimonial[] @relation("WebsiteTestimonialCreatedBy")

  // WhatsApp Business (ver secção WHATSAPP, fundo do ficheiro) — quem enviou
  // cada mensagem OUTBOUND a partir do DS OS.
  whatsappMessagesSent WhatsAppMessage[]
}

// ─────────────────────────────────────────────────────────────────────────
// CLIENTES
// ─────────────────────────────────────────────────────────────────────────

// type: "FAMILIA" | "INVESTIDOR" | "ARQUITETO_PARCEIRO"
model Client {
  id        String   @id @default(cuid())
  name      String
  email     String?
  phone     String?
  type      String   @default("FAMILIA")
  location  String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ── Portal do Cliente ──────────────────────────────────────────────
  // Autenticação própria do cliente, independente do User (equipa) —
  // ver src/lib/auth.ts (provider "cliente") e src/lib/client-session.ts.
  // portalActive controla, por cliente, se o login está disponível: o
  // gestor de projeto ativa isto manualmente (ver docs/pendencias-tecnicas.md
  // — a definir: fluxo de convite/definição de password em Definições).
  passwordHash      String?
  // Ver o mesmo campo em User — mesma finalidade de revogação imediata de
  // sessão, aplicada ao Portal do Cliente.
  passwordChangedAt DateTime?
  portalActive      Boolean   @default(false)
  lastLoginAt       DateTime?

  deals           Deal[]
  projects        Project[]
  tags            TagOnClient[]
  attachments     Attachment[]
  messages        ClientMessage[]
  waConversations WhatsAppConversation[]

  @@index([type])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────────────────
// CRM — LEADS / NEGÓCIOS (Pipeline Comercial)
// ─────────────────────────────────────────────────────────────────────────

// source: "GOOGLE_ADS" | "META_ADS" | "REFERENCIA" | "SEO_ORGANICO" | "GBP" | "OUTRO"
// projectType: "RESIDENCIAL" | "MORADIA" | "COMERCIAL" | "INVESTIMENTO"
// budgetRange: "R20_30K" | "R30_75K" | "R75_150K" | "R150K_PLUS"
// stage (ver docs/05_Processo_Comercial_Operacional_DS.md §1 — Pipeline Comercial;
//   as etapas 1.9 "Execução" e 1.10 "Pós-Venda" desse documento vivem no
//   modelo Project, não aqui — ver comentário do Project mais abaixo):
//   "NOVO_LEAD" | "QUALIFICADO" | "VISITA_AGENDADA" | "VISITA_REALIZADA" |
//   "PROPOSTA_ENVIADA" | "EM_NEGOCIACAO" | "FECHADO_GANHO" | "FECHADO_PERDIDO"
// lossReason (ver doc 05 §1.8 e §7.3):
//   "PRECO" | "PRAZO" | "CONCORRENTE" | "ADIOU" | "SEM_RESPOSTA" |
//   "FORA_DE_AMBITO" | "OUTRO"
// qualificationCategory — resultado do score de qualificação (doc 05 §3):
//   "FRACO" (0–2) | "POTENCIAL" (3–5) | "QUALIFICADO" (6–8) | "PRIORITARIO" (9–10)
model Deal {
  id                String    @id @default(cuid())
  title             String
  client            Client    @relation(fields: [clientId], references: [id])
  clientId          String
  stage             String    @default("NOVO_LEAD")
  source            String    @default("OUTRO")
  projectType       String    @default("RESIDENCIAL")
  budgetRange       String?
  amount            Float?
  marginEstimatePct Float?
  visitaTecnicaAt   DateTime?
  propostaEnviadaAt DateTime?
  probability       Int       @default(5)
  lossReason        String?
  owner             User?     @relation("DealOwner", fields: [ownerId], references: [id])
  ownerId           String?
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // ── Atribuição de origem (UTM/gclid/fbclid) — adicionado ago/2026 ──
  // Capturados no primeiro touchpoint do visitante no site (antes de
  // qualquer navegação interna) e persistidos até à submissão do
  // formulário — ver website/src/lib/analytics.ts (captureAttribution).
  // Todos opcionais e aditivos — negócios existentes ficam com estes
  // campos a null, sem qualquer impacto. "source" (acima) continua a ser
  // a classificação agregada (enum LEAD_SOURCE); estes campos preservam o
  // valor granular original da campanha para reporting e para uma futura
  // integração de conversões (Google Ads / Meta CAPI).
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmTerm     String?
  utmContent  String?
  gclid       String?
  fbclid      String?

  // ── Meta Conversions API (CAPI) — adicionado ago/2026 ──
  // metaLeadEventId: event_id gerado no browser no momento do submit do
  // formulário (ver website/src/lib/analytics.ts, trackLeadConversion) e
  // reenviado no evento CAPI equivalente (ver platform/src/lib/
  // meta-capi.ts) — permite à Meta deduplicar o Pixel (browser) e o CAPI
  // (servidor) como o mesmo evento "Lead", em vez de contar duas
  // conversões. metaFbp/metaFbc: identificadores de correlação definidos
  // pelo próprio Pixel da Meta (cookies _fbp/_fbc) no momento do lead,
  // guardados para reutilização no evento de fecho de negócio
  // (FECHADO_GANHO) — nessa altura já não há pedido do browser do
  // visitante original disponível para os ler de novo.
  metaLeadEventId String?
  metaFbp         String?
  metaFbc         String?

  // ── Meta Lead Ads (formularios nativos, "Instant Forms") — adicionado
  // ago/2026. Preenchidos apenas quando o negocio chega via
  // /api/webhooks/meta-leads -- nulos para todas as outras origens.
  // metaLeadgenId e a chave de deduplicacao: a Meta garante reentrega do
  // webhook "pelo menos uma vez", nunca exactamente uma vez -- a
  // constraint @unique impede criar dois negocios para o mesmo lead
  // nativo caso o mesmo evento chegue duas vezes.
  metaLeadgenId    String? @unique
  metaCampaignId   String?
  metaCampaignName String?
  metaAdsetId      String?
  metaAdsetName    String?
  metaAdId         String?
  metaAdName       String?
  metaFormId       String?
  metaFormName     String?

  // ── Processo comercial operacional (doc 05) — adicionado Fase 1, ago/2026 ──
  // firstContactedAt: quando a "Primeiro Contacto" (ver Task) foi de facto
  // concluída — mede o SLA real de resposta (doc 05 §2), distinto de
  // createdAt (entrada do lead). Nulo enquanto o lead não foi contactado.
  firstContactedAt      DateTime?
  // qualificationScore/qualificationCategory: resultado do formulário de
  // qualificação (doc 05 §3, 5 critérios de 0–2 pontos, máx. 10). Só
  // preenchidos quando o negócio passa pela etapa "Qualificado" — nulos
  // antes disso. Ver src/lib/qualification.ts para a fórmula.
  qualificationScore    Int?
  qualificationCategory String?

  project         Project?
  tags            TagOnDeal[]
  tasks           Task[]
  waConversations WhatsAppConversation[]

  @@index([clientId])
  @@index([ownerId])
  @@index([stage])
  @@index([source])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────────────────
// OBRAS (Pipeline de Projeto, pós-fecho)
// ─────────────────────────────────────────────────────────────────────────

// stage (ver docs/crm-especificacao.md §4 — Pipeline de Projeto):
//   "HANDOVER" | "KICKOFF_AGENDADO" | "PREPARACAO" | "EXECUCAO" |
//   "CONTROLO_QUALIDADE" | "VISTORIA_CLIENTE" | "ENTREGUE" | "POS_OBRA_GARANTIA"
model Project {
  id           String    @id @default(cuid())
  title        String
  client       Client    @relation(fields: [clientId], references: [id])
  clientId     String
  deal         Deal?     @relation(fields: [dealId], references: [id])
  dealId       String?   @unique
  stage        String    @default("HANDOVER")
  serviceType  String    @default("RESIDENCIAL")
  location     String?
  startDate    DateTime?
  dueDate      DateTime?
  deliveredAt  DateTime?
  budgetAmount Float?
  costAmount   Float?
  owner        User?     @relation("ProjectOwner", fields: [ownerId], references: [id])
  ownerId      String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tasks       Task[]
  invoices    Invoice[]
  events      CalendarEvent[]
  tags        TagOnProject[]
  attachments Attachment[]
  messages    ClientMessage[]

  // Ligação opcional à ficha pública desta obra no site (ver WebsiteCaseStudy
  // mais abaixo). Deliberadamente opcional e sem cascade: uma obra interna
  // pode nunca chegar a ser publicada, e apagar a ficha pública nunca deve
  // apagar o Project real.
  websiteCaseStudy WebsiteCaseStudy?

  @@index([clientId])
  @@index([ownerId])
  @@index([stage])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────────────────
// ETIQUETAS (Tags) — ver docs/crm-especificacao.md §5
// ─────────────────────────────────────────────────────────────────────────

model Tag {
  id      String  @id @default(cuid())
  name    String  @unique
  meaning String?

  clients  TagOnClient[]
  deals    TagOnDeal[]
  projects TagOnProject[]
}

model TagOnClient {
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId String
  tag      Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)
  tagId    String

  @@id([clientId, tagId])
}

model TagOnDeal {
  deal   Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)
  dealId String
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)
  tagId  String

  @@id([dealId, tagId])
}

model TagOnProject {
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)
  tagId     String

  @@id([projectId, tagId])
}

// ─────────────────────────────────────────────────────────────────────────
// TAREFAS (transversal a CRM / Obras / RH)
// ─────────────────────────────────────────────────────────────────────────

// status: "PENDENTE" | "EM_CURSO" | "CONCLUIDA" | "CANCELADA"
model Task {
  id          String    @id @default(cuid())
  title       String
  description String?
  status      String    @default("PENDENTE")
  priority    String    @default("NORMAL")
  dueAt       DateTime?
  assignee    User?     @relation("TaskAssignee", fields: [assigneeId], references: [id])
  assigneeId  String?
  deal        Deal?     @relation(fields: [dealId], references: [id])
  dealId      String?
  project     Project?  @relation(fields: [projectId], references: [id])
  projectId   String?
  createdBy   User?     @relation("TaskCreator", fields: [createdById], references: [id])
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  comments    TaskComment[]
  attachments Attachment[]

  @@index([assigneeId])
  @@index([dealId])
  @@index([projectId])
  @@index([status])
  @@index([dueAt])
}

// ─────────────────────────────────────────────────────────────────────────
// AGENDA
// ─────────────────────────────────────────────────────────────────────────

// type: "VISITA_TECNICA" | "REUNIAO" | "KICKOFF" | "VISTORIA" | "OUTRO"
model CalendarEvent {
  id        String    @id @default(cuid())
  title     String
  type      String    @default("OUTRO")
  startAt   DateTime
  endAt     DateTime?
  location  String?
  project   Project?  @relation(fields: [projectId], references: [id])
  projectId String?
  notes     String?
  createdAt DateTime  @default(now())

  @@index([projectId])
  @@index([startAt])
}

// ─────────────────────────────────────────────────────────────────────────
// FINANCEIRO
// ─────────────────────────────────────────────────────────────────────────

// status: "EMITIDA" | "PAGA" | "ATRASADA" | "CANCELADA"
model Invoice {
  id        String    @id @default(cuid())
  number    String    @unique
  project   Project?  @relation(fields: [projectId], references: [id])
  projectId String?
  amount    Float
  status    String    @default("EMITIDA")
  issueDate DateTime  @default(now())
  dueDate   DateTime?
  paidAt    DateTime?
  createdAt DateTime  @default(now())

  payments Payment[]

  @@index([projectId])
  @@index([status])
}

model Payment {
  id        String   @id @default(cuid())
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId String
  amount    Float
  paidAt    DateTime @default(now())
  method    String?

  @@index([invoiceId])
}

// ─────────────────────────────────────────────────────────────────────────
// RECURSOS HUMANOS
// ─────────────────────────────────────────────────────────────────────────

// status: "ATIVO" | "INATIVO" | "FERIAS"
model Employee {
  id         String    @id @default(cuid())
  user       User?     @relation(fields: [userId], references: [id])
  userId     String?   @unique
  name       String
  jobTitle   String
  department String?
  status     String    @default("ATIVO")
  startDate  DateTime?
  email      String?
  phone      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([status])
}

// ─────────────────────────────────────────────────────────────────────────
// MARKETING
// ─────────────────────────────────────────────────────────────────────────

// channel: "GOOGLE_ADS" | "META_ADS" | "SEO" | "EMAIL" | "REFERRAL" | "OUTRO"
model MarketingCampaign {
  id        String    @id @default(cuid())
  name      String
  channel   String    @default("OUTRO")
  budget    Float?
  startDate DateTime?
  endDate   DateTime?
  active    Boolean   @default(true)
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────
// AUDITORIA
// ─────────────────────────────────────────────────────────────────────────

model ActivityLog {
  id        String   @id @default(cuid())
  user      User?    @relation(fields: [userId], references: [id])
  userId    String?
  action    String
  entity    String
  entityId  String?
  meta      String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────────────────
// FICHEIROS (fotografias, documentos, contratos, PDFs)
// ─────────────────────────────────────────────────────────────────────────

// Guardados em disco (ver src/lib/storage.ts) — path é relativo à pasta de
// armazenamento configurada por STORAGE_DIR. Servidos apenas através de
// /api/files/[id], que exige sessão válida (nunca em /public).
// kind: "DOCUMENTO" | "FOTO_OBRA" | "RELATORIO" | "OUTRO" — determina em que
// separador do Portal do Cliente (Documentos / Fotos / Relatórios) o ficheiro
// aparece. visibleToClient é o interruptor de privacidade: por omissão
// `false` — um ficheiro só aparece no portal depois de o gestor de projeto
// o marcar explicitamente como visível (nunca automático).
model Attachment {
  id              String  @id @default(cuid())
  filename        String // nome gerado (único em disco)
  originalName    String // nome original do ficheiro enviado
  mimeType        String
  size            Int
  path            String // caminho relativo dentro da pasta de armazenamento
  kind            String  @default("OUTRO")
  visibleToClient Boolean @default(false)

  client    Client?  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId  String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String?
  task      Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId    String?

  uploadedBy   User?    @relation(fields: [uploadedById], references: [id])
  uploadedById String?
  createdAt    DateTime @default(now())

  @@index([clientId])
  @@index([projectId])
  @@index([taskId])
  @@index([projectId, kind, visibleToClient])
}

// ─────────────────────────────────────────────────────────────────────────
// MENSAGENS DO PORTAL DO CLIENTE
// ─────────────────────────────────────────────────────────────────────────

// authorType: "CLIENTE" | "EQUIPA" — thread simples por projeto, visível
// tanto no Portal do Cliente como (a construir) num painel de mensagens
// dentro do módulo Obras da equipa interna.
model ClientMessage {
  id           String   @id @default(cuid())
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId    String
  client       Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId     String
  authorType   String
  authorName   String
  body         String
  readByTeam   Boolean  @default(false)
  readByClient Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([projectId])
  @@index([clientId])
}

// ─────────────────────────────────────────────────────────────────────────
// COMENTÁRIOS DE TAREFAS
// ─────────────────────────────────────────────────────────────────────────

model TaskComment {
  id        String   @id @default(cuid())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId    String
  author    User?    @relation(fields: [authorId], references: [id])
  authorId  String?
  body      String
  createdAt DateTime @default(now())

  @@index([taskId])
}

// ─────────────────────────────────────────────────────────────────────────
// NOTIFICAÇÕES (Fase 4 — doc 05_Processo_Comercial_Operacional_DS.md §7.4)
// ─────────────────────────────────────────────────────────────────────────

// type: "LEAD_NOVO" | "SLA_RISCO" | "SLA_VIOLADO" | "FOLLOWUP_DUE" |
//   "PROPOSTA_ENVIADA" | "PROPOSTA_ACEITE" | "PROPOSTA_RECUSADA"
// Regista cada notificação de facto ENVIADA por email (via Resend, ver
// src/lib/email.ts) — usado só para idempotência (nunca reenviar o mesmo
// alerta duas vezes a partir da verificação periódica em
// /api/internal/notifications-check), nunca para lógica de negócio.
// Sem relação FK a Task/Deal deliberadamente: é um registo leve de
// auditoria de envio, não deve obrigar a regras de cascade/onDelete nos
// modelos principais só por causa disto — dealId/taskId são só referência
// informativa (podem apontar para um registo entretanto apagado).
model Notification {
  id        String   @id @default(cuid())
  type      String
  dealId    String?
  taskId    String?
  sentTo    String
  createdAt DateTime @default(now())

  @@index([type, taskId])
  @@index([type, dealId])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────────────────
// WEBSITE — CMS INTERNO (Site "Portefólio")
// ─────────────────────────────────────────────────────────────────────────
// Adicionado autonomamente (ago/2026) como base para o pedido "CMS interno /
// Integração DS OS → Website / Sistema de publicação" — ver
// docs/website-cms-integracao.md para o desenho completo e o porquê da
// decisão de NÃO expor uma API pública ao website nesta v1.
//
// Resumo: estes modelos são deliberadamente separados do `Project` (que tem
// dados internos sensíveis — orçamento, custo, cliente). Uma `WebsiteCaseStudy`
// é conteúdo curado à mão para publicação, nunca um espelho automático de um
// `Project`. A ligação a `projectId` é só para referência interna (saber a
// que obra real corresponde), nunca para expor dados do `Project` no site.
//
// IMPORTANTE: estes modelos ainda não existem na base de dados. Adicionar
// aqui ao schema.prisma é o primeiro passo, mas só têm efeito depois de:
//   1. Reveres os modelos abaixo;
//   2. Correres `npx prisma db push` (ou adotares migrations versionadas,
//      como está no Roadmap Prioridade 1) contra a base de dados de destino;
//   3. Correres `npx prisma generate`.
// Isto NÃO foi executado — nem local nem em produção — como parte deste
// trabalho, propositadamente, dado que qualquer alteração à base de dados
// de produção segue a tua regra de nunca assumir/alterar sem validação e
// aprovação explícitas.

// category: um dos valores de ServiceCategory no website (residencial |
// premium | cozinhas | casas-de-banho | moradias | comercial)
// status: DRAFT | PUBLISHED — só entra no "Exportar conteúdo" quando PUBLISHED.
model WebsiteCaseStudy {
  id       String @id @default(cuid())
  slug     String @unique
  title    String
  category String
  location String
  summary  String

  // Estrutura narrativa — todos opcionais, tal como no website (ver CaseStudy
  // em website/src/types/index.ts).
  challenge String?
  planning  String?
  execution String?
  solution  String?
  result    String?

  servicesRealized String[] // slugs de website/src/lib/site-data.ts (services[].slug)
  duration         String?
  materials        String[]
  featured         Boolean  @default(false)

  status      String    @default("DRAFT")
  publishedAt DateTime?

  project   Project? @relation(fields: [projectId], references: [id])
  projectId String?  @unique

  media        WebsiteMediaAsset[]
  testimonials WebsiteTestimonial[]

  createdBy   User?    @relation("WebsiteCaseStudyCreatedBy", fields: [createdById], references: [id])
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([category])
}

// kind: "foto" | "video" — role: "cover" | "gallery" | "video"
// phase (só relevante para kind "foto" em role "gallery"): "antes" | "durante" | "depois"
model WebsiteMediaAsset {
  id          String           @id @default(cuid())
  caseStudy   WebsiteCaseStudy @relation(fields: [caseStudyId], references: [id], onDelete: Cascade)
  caseStudyId String

  kind        String
  role        String
  phase       String?
  orientation String? // "horizontal" | "vertical"
  src         String? // caminho relativo (ex.: "/media/obras/slug/foto-01.jpg") — decisão de storage ainda em aberto, ver docs/website-cms-integracao.md
  embedUrl    String? // YouTube/Vimeo, quando kind = "video"
  alt         String?
  caption     String?
  sortOrder   Int     @default(0)

  @@index([caseStudyId])
}

// kind: "texto" | "video"
model WebsiteTestimonial {
  id         String  @id @default(cuid())
  kind       String
  clientName String?
  location   String?
  quote      String?
  embedUrl   String?
  photo      String?
  rating     Int?
  authorized Boolean @default(false)

  caseStudy   WebsiteCaseStudy? @relation(fields: [caseStudyId], references: [id])
  caseStudyId String?

  createdBy   User?    @relation("WebsiteTestimonialCreatedBy", fields: [createdById], references: [id])
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([authorized])
}

// ─────────────────────────────────────────────────────────────────────────
// WHATSAPP (WhatsApp Business Cloud API) — adicionado ago/2026
// ─────────────────────────────────────────────────────────────────────────

// Uma conversa por numero de telefone -- a Meta trata cada contacto do
// WhatsApp Business como uma thread continua, nao por mensagem individual.
// Ligada a Client/Deal quando o numero e reconhecido (ver
// /api/webhooks/whatsapp); fica sem ligacao (clientId/dealId nulos) se a
// mensagem chegar de um numero que ainda nao existe como Client -- deve
// aparecer numa lista de conversas por associar, para associacao manual.
model WhatsAppConversation {
  id            String    @id @default(cuid())
  client        Client?   @relation(fields: [clientId], references: [id])
  clientId      String?
  deal          Deal?     @relation(fields: [dealId], references: [id])
  dealId        String?
  phoneNumber   String    @unique // E.164, ex.: "+351912345678"
  waContactName String?
  lastMessageAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  messages WhatsAppMessage[]

  @@index([clientId])
  @@index([dealId])
}

// direction: "INBOUND" | "OUTBOUND"
// status (so relevante para OUTBOUND, atualizado pelo webhook de
// "statuses" da Meta): "ENVIADA" | "ENTREGUE" | "LIDA" | "FALHOU"
model WhatsAppMessage {
  id             String               @id @default(cuid())
  conversation   WhatsAppConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String
  direction      String
  waMessageId    String?              @unique
  body           String?
  templateName   String?
  status         String               @default("RECEBIDA")
  sentBy         User?                @relation(fields: [sentById], references: [id])
  sentById       String?
  createdAt      DateTime             @default(now())

  @@index([conversationId])
  @@index([createdAt])
}
