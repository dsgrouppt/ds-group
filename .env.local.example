# ===== Google Tag Manager =====
# Recomendado como camada principal — gere GA4 e Meta Pixel a partir do próprio GTM.
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# ===== Google Analytics 4 =====
# Preencher APENAS se o GA4 não estiver a ser carregado via GTM (evita disparo duplicado de pageviews).
NEXT_PUBLIC_GA_ID=

# ===== Meta Pixel =====
# Preencher APENAS se o Pixel não estiver a ser carregado via GTM.
NEXT_PUBLIC_META_PIXEL_ID=

# ===== HubSpot Forms API (formulário de contacto) =====
# Portal ID da conta HubSpot e GUID do formulário criado em Marketing > Formulários.
HUBSPOT_PORTAL_ID=00000000
HUBSPOT_FORM_GUID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ===== Site =====
NEXT_PUBLIC_SITE_URL=https://www.dsprojects.pt
